<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#3A4B47" />
            <corners android:radius="7dp" />
            <stroke android:width="2dp" android:color="@color/drift_primary" />
            <padding android:left="3dp" android:top="2dp" android:right="3dp" android:bottom="2dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/drift_surface_high" />
            <corners android:radius="7dp" />
            <stroke android:width="2dp" android:color="@color/drift_primary" />
            <padding android:left="3dp" android:top="2dp" android:right="3dp" android:bottom="2dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F2202826" />
            <corners android:radius="7dp" />
            <stroke android:width="1dp" android:color="@color/drift_outline" />
            <padding android:left="3dp" android:top="2dp" android:right="3dp" android:bottom="2dp" />
        </shape>
    </item>
</selector>
