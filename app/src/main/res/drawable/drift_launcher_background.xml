<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <!-- Shape gradients require 45-degree increments; horizontal is closest to the SVG. -->
            <gradient
                android:angle="0"
                android:startColor="#58ADFC"
                android:centerColor="#5ACBF0"
                android:centerX="0.48"
                android:endColor="#8AF9DA"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1FC6FAFF"
                android:centerColor="#00C6FAFF"
                android:centerY="0.45"
                android:endColor="#6EC6FFF0"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
