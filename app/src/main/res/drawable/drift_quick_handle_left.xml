<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/drift_on_primary" />
            <corners android:radius="2dp" android:topLeftRadius="0dp" android:topRightRadius="14dp" android:bottomRightRadius="14dp" android:bottomLeftRadius="0dp" />
            <stroke android:width="2dp" android:color="@color/drift_primary" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/drift_surface_high" />
            <corners android:radius="2dp" android:topLeftRadius="0dp" android:topRightRadius="14dp" android:bottomRightRadius="14dp" android:bottomLeftRadius="0dp" />
            <stroke android:width="2dp" android:color="@color/drift_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/drift_surface" />
            <corners android:radius="2dp" android:topLeftRadius="0dp" android:topRightRadius="14dp" android:bottomRightRadius="14dp" android:bottomLeftRadius="0dp" />
            <stroke android:width="1dp" android:color="@color/drift_outline" />
        </shape>
    </item>
</selector>
