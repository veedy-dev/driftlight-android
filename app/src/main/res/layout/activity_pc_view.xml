<?xml version="1.0" encoding="utf-8"?>
<!--
THESIS: Driftlight is a controller-first field console, not a legacy icon grid.
OWN-WORLD: Matte basalt, mineral graphite, warm white, and one pale-mint focus signal.
STORY: Find a host, read its state, and launch without visual noise.
FIRST VIEWPORT: A compact brand bar anchors a generous host field with unmistakable focus.
FORM: Mineral field kit, grounded direction 6, seed e684d454.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/drift_bg"
    android:paddingStart="24dp"
    android:paddingTop="18dp"
    android:paddingEnd="24dp"
    android:paddingBottom="18dp"
    tools:context=".PcView">

    <TextView
        android:id="@+id/driftlight_wordmark"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_alignParentStart="true"
        android:gravity="center_vertical"
        android:text="@string/app_label"
        android:textAppearance="@style/TextAppearance.Driftlight.ScreenTitle"
        android:textSize="32sp" />

    <ImageButton
        android:id="@+id/manuallyAddPc"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentEnd="true"
        android:background="@drawable/drift_icon_button"
        android:contentDescription="@string/title_add_pc"
        android:nextFocusLeft="@id/helpButton"
        android:padding="15dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_add"
        app:tint="@color/drift_text" />

    <ImageButton
        android:id="@+id/helpButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="10dp"
        android:layout_toStartOf="@id/manuallyAddPc"
        android:background="@drawable/drift_icon_button"
        android:contentDescription="@string/help"
        android:nextFocusLeft="@id/settingsButton"
        android:nextFocusRight="@id/manuallyAddPc"
        android:padding="15dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_help"
        app:tint="@color/drift_text" />

    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="10dp"
        android:layout_toStartOf="@id/helpButton"
        android:background="@drawable/drift_icon_button"
        android:contentDescription="@string/category_general_settings"
        android:nextFocusRight="@id/helpButton"
        android:padding="15dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_settings"
        app:tint="@color/drift_text" />

    <RelativeLayout
        android:id="@+id/pcFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/driftlight_wordmark"
        android:layout_marginTop="18dp"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/no_pc_found_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/pcs_loading"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/drift_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="@string/searching_pc"
                android:textColor="@color/drift_text_muted"
                android:textSize="18sp" />
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
