<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppBaseTheme" parent="Theme.Material3.Dark.NoActionBar" />

    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/drift_bg</item>
        <item name="android:navigationBarColor">@color/drift_bg</item>
        <item name="android:statusBarColor">@color/drift_bg</item>
        <item name="colorPrimary">@color/drift_primary</item>
        <item name="colorOnPrimary">@color/drift_on_primary</item>
        <item name="colorSecondary">@color/drift_primary</item>
        <item name="colorOnSecondary">@color/drift_on_primary</item>
        <item name="colorSurface">@color/drift_surface</item>
        <item name="colorOnSurface">@color/drift_text</item>
        <item name="colorSurfaceVariant">@color/drift_surface_high</item>
        <item name="colorOnSurfaceVariant">@color/drift_text_muted</item>
        <item name="colorOutline">@color/drift_outline</item>
        <item name="colorError">@color/drift_error</item>
        <item name="android:colorAccent">@color/drift_primary</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Driftlight.MaterialAlertDialog</item>
    </style>

    <style name="StreamBaseTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="StreamTheme" parent="AppTheme">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
    </style>

    <style name="SettingsTheme" parent="AppTheme">
        <item name="android:windowBackground">@color/drift_bg</item>
    </style>

    <style name="ThemeOverlay.Driftlight.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/drift_surface_high</item>
        <item name="colorOnSurface">@color/drift_text</item>
        <item name="colorPrimary">@color/drift_primary</item>
        <item name="colorSecondary">@color/drift_primary</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Driftlight.Medium</item>
    </style>

    <style name="ShapeAppearance.Driftlight.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">14dp</item>
    </style>

    <style name="TextAppearance.Driftlight.ScreenTitle" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/drift_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.Driftlight.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/drift_text_muted</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <declare-styleable name="ApertureViewGroup">
        <attr name="aperture_color1" format="color" />
        <attr name="aperture_color2" format="color" />
        <attr name="aperture_border_width" format="dimension" />
        <attr name="aperture_border_angle" format="dimension" />
        <attr name="aperture_duration" format="integer" />
        <attr name="aperture_middle_color" format="color" />
    </declare-styleable>

</resources>
